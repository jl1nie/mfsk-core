{
  "_note": "One task per entry: what upstream is asked to do, and how this crate is asked to do the same thing. scripts/upstream-baseline.py reads the upstream half. The sweep test reads the crate half through `sweep_env`. Edit both halves together, or the comparison stops meaning anything. T1 is wideband monitoring: 200-3000 Hz, no callsign known, upstream at its deepest setting with AP left at its default, and this crate at its counterpart of that setting. Q65 has no wideband-only form in jt9: `-3` always tries its Rx frequency first. Its task therefore gives the Rx frequency. Build the upstream binaries with scripts/build_jt9_upstream.sh.",
  "ft8/t1": {
    "runner_csv": "ft8.csv",
    "task": "Wideband monitoring, 200-3000 Hz, no callsign known. WSJT-X Deep with AP enabled, which with no callsigns tries only the CQ hypothesis.",
    "upstream_bin": "jt9",
    "upstream_args": ["-8", "-d", "3", "-L", "200", "-H", "3000"],
    "crate": "DecodeRequest::<Ft8>::wsjtx_depth(audio, 200, 3000, 1.3, 1000, WsjtxDepth::D3, Some(CQ hint))",
    "score": {"msg": "CQ JL1NIE PM95", "freq": 1500, "freq_tol": 5, "dt_tol": 0.6},
    "corpus": "ft8_sweep",
    "file_re": "^ft8_(?P<channel>awgn|ccir_\\w+?)_(?P<tag>[mp]\\d+)_(?P<trial>\\d+)\\.wav$",
    "groups": ["channel"],
    "sweep_test": "ft8_sweep", "sweep_filter": "ft8_snr_sweep",
    "sweep_env": {"MFSK_FT8_SWEEP_TASK": "t1"},
    "sweep_csv_env": "MFSK_FT8_SWEEP_CSV", "sweep_dir_env": "MFSK_FT8_SWEEP_DIR"
  },
