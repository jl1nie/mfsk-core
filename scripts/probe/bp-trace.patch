 /// [`bp_decode_generic_nms`] with caller-provided scratch — eliminates
 /// the per-call ~12 KB allocation churn on the BP staircase hot path.
+
+pub static PROBE_HOOK: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+#[inline]
+fn probe_hook(t: &[u16], ok: bool) {
+    let h = PROBE_HOOK.load(core::sync::atomic::Ordering::Relaxed);
+    if h != 0 {
+        let f: fn(&[u16], bool) = unsafe { core::mem::transmute(h) };
+        f(t, ok);
+    }
