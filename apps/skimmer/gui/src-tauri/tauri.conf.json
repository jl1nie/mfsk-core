{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mfsk skimmer",
  "version": "0.13.1",
  "identifier": "io.github.jl1nie.mfsk-skimmer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mfsk skimmer",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  }
}
