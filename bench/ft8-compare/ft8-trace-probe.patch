+/// PROBE (not for commit): write-only trace of the FT8 decode stages, the counterpart of
+/// `JT9_TRACE` in scripts/build_jt9_upstream.sh. Off unless `MFSK_FT8_TRACE=<file>` is set.
+#[cfg(feature = "std")]
+pub(crate) mod ptrace {
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+    static SINK: OnceLock<Option<Mutex<std::fs::File>>> = OnceLock::new();
+    thread_local! { static STAGE: core::cell::Cell<&'static str> = const { core::cell::Cell::new("-") }; }
+    fn sink() -> &'static Option<Mutex<std::fs::File>> {
+        SINK.get_or_init(|| {
+            std::env::var("MFSK_FT8_TRACE").ok().and_then(|p| {
+                std::fs::OpenOptions::new().create(true).append(true).open(p).ok().map(Mutex::new)
+            })
+        })
+    }
+    pub fn on() -> bool { sink().is_some() }
+    pub fn set_stage(s: &'static str) { STAGE.with(|c| c.set(s)); }
+    pub fn stage() -> &'static str { STAGE.with(|c| c.get()) }
+    pub fn line(s: String) {
+        if let Some(m) = sink() { let _ = writeln!(m.lock().unwrap(), "{s}"); }
+    }
+}
