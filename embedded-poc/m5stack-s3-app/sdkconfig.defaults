# M5StickS3 IC-705 FT8 コントローラ — sdkconfig defaults.
#
# 前提: 兄弟クレート `m5stack-s3` (compute bench) の sdkconfig をベース
# に、本アプリ向けに **BLE central** と **USB host** を有効化、partition
# table に littlefs を追加。WiFi は当面オフのまま。

CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# ── Flash + partition table ──────────────────────────────────────────
# M5StickS3 = ESP32-S3-PICO-1-N8R8 (8 MB flash, 8 MB Octal PSRAM).
# Earlier bootloader run reported "SPI Flash Size: 4 MB" — that was a
# stale bootloader.bin built before this sdkconfig change took effect.
# Force-rebuild via `cargo clean -p esp-idf-sys` if you see the same.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_PARTITION_TABLE_CUSTOM_FILENAME は build.rs が生成する
# `sdkconfig.gen.defaults` (Cargo.toml の esp_idf_sdkconfig_defaults
# 経由でマージ) で絶対パスを埋め込む。ESP-IDF は CSV パスを CMake
# build dir 基準で解決するため絶対パス必須 — 開発機ごとに $HOME が
# 違うので静的にコミットできない (旧コミット 119657a の二の舞回避)。
# 初回ビルド前に `./bootstrap-sdkconfig.sh` を実行すること。

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# ── Bluetooth (BLE only, NimBLE host) ────────────────────────────────
# Phase 2-Stick (2026-05-17): CI-V via BLE to IC-705 (esp32-nimble
# central). M5StickS3 が USB host できない hardware 制約のため、IC-705
# 制御は BLE GATT に集約 (K7MDL2 reference protocol)。
# BootMode::Acoustic / Decode で BLE スタックを起動、PTT 制御 +
# GPS UTC supplement 取得 + (将来) S-meter / band 同期 etc.
# NimBLE central のみ (peripheral / observer / broadcaster は無効) で
# DRAM footprint 最小化。Acoustic mode は WiFi off にしてあるので net
# +40 KB (BLE) - 80 KB (WiFi) = -40 KB の総増減。
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Push NimBLE host allocations to PSRAM so internal DRAM stays for
# the audio capture + stage1_inc workers (stage1_inc spawn fails on
# pre-BLE-baseline if internal largest drops below 16 KB; PSRAM
# placement frees ~10-15 KB internal).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Trim NimBLE task stack to the central-only minimum (4 KB instead
# of the default 5 KB) — we don't run peripheral / GATT server work.
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=4096
# Trim controller resources for the single-link CI-V central use.
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1

# ── Networking ───────────────────────────────────────────────────────
# Phase 0.6: WiFi STA + UDP socket — IC-705 が USB-OTG を占有すると
# `espflash monitor` が物理的に塞がるので、UART/LCD と並列に UDP
# datagram で PC に log を吐く独立経路が必要。BLE (NimBLE) との coex は
# esp-idf default の software coex で動く想定 — 干渉が出たら
# `CONFIG_ESP_COEX_*` を調整 (Phase 0.6 実機検証で確認)。
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_LWIP_TCP_ENABLED=y
CONFIG_LWIP_UDP_ENABLED=y

# ── USB Host (UAC capture) ───────────────────────────────────────────
# Phase 1: IC-705 audio capture via espressif/usb_host_uac 1.4.x
# (managed component pulled in via Cargo.toml extra_components). Host
# stack を常時 link し、runtime には `BootMode::Uac` でのみ
# `uac_host_install()` を呼ぶ。Host driver は ~20-30 KB DRAM を常時
# 消費する (BootMode::Decode/Wifi でも) が、boot-time mode dispatch
# で機能切り替えする方が field UX として簡潔。
#
# 注意: USB host を install すると USB-Serial-JTAG endpoint が
# auto-detach され、`println!` 系の console は USB 経路から消える。
# `BootMode::Uac` では WiFi STA + UDP log を必ず up させること
# (main.rs dispatch arm 側で強制)。
CONFIG_USB_HOST_ENABLED=y

# ── PSRAM (Octal 8 MB) ────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
# 兄弟クレート (compute bench) と同じく 4096 — dual-core decode で
# stage 3 cs Box (5 KB × 15 × 2) が内蔵 DRAM に貼り付くと tlsf 破壊。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ── Task watchdog ────────────────────────────────────────────────────
# ライブ RX は task ごとに yield する設計なので WDT は ON のままでよい。
# Phase 1 で長時間 isochronous loop を組む際に再評価。
# CONFIG_ESP_TASK_WDT_INIT=y  (default)

# ── esp-dsp FFT — 8192 twiddle table ─────────────────────────────────
CONFIG_DSP_MAX_FFT_SIZE_8192=y
