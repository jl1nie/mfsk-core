# M5Stack CoreS3 FT8 controller — sdkconfig defaults (Phase 1-Core).
#
# CoreS3-specific vs sibling crates:
#   1. SPIRAM_MODE_QUAD (CoreS3 has 8 MB Quad PSRAM; StickS3 is Octal).
#   2. Flash size 16 MB (same as Core2; StickS3 is 8 MB).
#   3. USB host enabled in Phase 1-Core (AW9523B BUS_OUT_EN drives VBUS).
#      BLE deferred to Phase 2-Core.
#   4. No SPIRAM_MODE_OCT block (unlike s3-app sdkconfig).

# 32768 was sized for a `display::run_log_panel` that put a 13.5 KB
# waterfall snapshot (and the `.collect()` temporary behind it) on the
# stack. With those boxed, the function's high-water mark measured
# 5,080 B — so 32 KB was 27 KB of internal DRAM held to cover a bug.
#
# That DRAM is the resource the USB host path is actually short of:
# host stack + three enumerated devices + the isochronous audio buffer
# + lwIP + the WiFi driver all want the same DMA-capable region, and
# WiFi is not optional here (NTP, the HTTP config UI, and QSO log
# upload all ride on it). 16 KB leaves ~11 KB of headroom over the
# measured mark, which is room for the panel to grow without being
# room for another overflow to hide in.
#
# `stack_hw` in the alive tick is the number to check before changing
# this either way.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ── Clocks ───────────────────────────────────────────────────────────
# ESP-IDF's default for esp32s3 is 160 MHz, and no crate in this tree
# ever overrode it — every device log in `embedded-poc/*/logs/` reports
# `cpu freq: 160000000 Hz`. The CoreS3's LX7 is rated for 240 MHz, so
# the default was leaving a third of the chip on the floor. Found
# 2026-08-13 while measuring the WSPR candidate loop
# (`docs/notes/WSPR_EMBEDDED_MEASUREMENT_RESULTS.md`).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ── Flash + partition table ──────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_PARTITION_TABLE_CUSTOM_FILENAME is written by build.rs /
# bootstrap-sdkconfig.sh with this checkout's absolute CSV path.
# Run `./bootstrap-sdkconfig.sh` once on a fresh clone.

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Catch a stack overflow at the instruction that overflows (#163).
#
# The default canary check only looks at a context switch, so by the
# time it fires the writer is long gone and the backtrace names the
# victim. This puts a hardware watchpoint on the last words of each
# task's stack, which panics on the store itself.
#
# It matters here because a task stack on this board is heap memory
# with the internal heap pool immediately below it: an overflow does
# not fault, it silently rewrites TLSF block headers, and the crash
# surfaces later and elsewhere (`tlsf_walk_pool`, LoadProhibited on a
# garbage address). That is exactly the shape of the 2026-08-23 bug.
#
# Costs one of the debug watchpoints. Keep it — this class of failure
# is invisible without it, and the app uses no others.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# ── Bluetooth (off in Phase 0-Core) ─────────────────────────────────
# CI-V over BLE is a Phase 2-Core item.
CONFIG_BT_ENABLED=n

# ── Networking ───────────────────────────────────────────────────────
# WiFi STA + UDP datagram log sink — same role as both sibling apps.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_LWIP_TCP_ENABLED=y
CONFIG_LWIP_UDP_ENABLED=y

# WiFi sized for a beacon, not for throughput (#163).
#
# WiFi is not optional on this board — NTP, the HTTP config UI and QSO
# log upload all ride on it, and an FST4/WSPR beacon has to keep it up
# while the USB host stack is running. Measured 2026-08-23: bringing
# WiFi up costs ~105 KB of internal DRAM (173,607 -> 68,499 free) and
# drops the largest contiguous block from 98,304 to 31,744. That block
# size, not the total, is what a UAC transfer buffer has to fit in.
#
# `SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y` is already on and cannot move
# these: the static pools are DMA targets, so they are internal by
# construction. The only way down is to ask for fewer of them.
#
# The defaults this replaces were throughput-tuned (STATIC_RX 16 vs
# IDF's 10, a static TX pool of 16). This traffic is a few hundred
# bytes of NTP, an occasional config page and a log upload; none of it
# is bandwidth-bound. Dynamic TX buffers additionally become eligible
# for PSRAM, which the static pool never was — that pool is the 32 KB
# that `SPIRAM_TRY_ALLOCATE_WIFI_LWIP` appeared to "cost" at boot.
#
# If WiFi throughput ever matters here, raise these first, and expect
# the USB host path to start failing its allocations again.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Dynamic TX buffers are NOT available here, and this is not a
# mistake to re-attempt. IDF gates them on
#
#   depends on !(SPIRAM_TRY_ALLOCATE_WIFI_LWIP && !SPIRAM_IGNORE_NOTFOUND)
#
# and `SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y` is mandatory on this board
# (without it lwIP/WiFi abort into a reboot loop — 7-11 reboots per
# 100 s, measured). So the TX pool is static by construction and the
# only lever is how many buffers it holds. Note also that the derived
# `ESP_WIFI_TX_BUFFER_TYPE` is a read-only int: writing it here is
# silently ignored, which is how this looked like a working change
# for one build.
#
# 6 x ~1.6 KB instead of 16. `CACHE_TX_BUFFER_NUM` is the overflow
# queue used when a static buffer cannot be had, and it is
# PSRAM-eligible, so it absorbs the reduction.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# ── PSRAM (Quad 8 MB) ─────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# Same story as the CPU clock: IDF defaults Quad PSRAM to 40 MHz. The
# CoreS3's part runs at 80 MHz, which is what M5Stack's own board
# support uses.
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_USE_MALLOC=y
# Mandatory for dual-core decode: same constraint as both sibling crates.
# Keeps allocations ≤4096 B in internal DRAM, preventing TLSF corruption
# when stage-3 cs Box buffers are placed in internal DRAM by both workers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Lets a task explicitly request its *stack* from PSRAM instead of
# internal DRAM (opt-in per task via task_caps; nothing that doesn't
# ask for MALLOC_CAP_SPIRAM is affected). Added 2026-08-15 so
# `mfsk-app-shared::http_config`'s HTTP server task can move off
# internal DRAM — wspr_app.rs's own scan/DDC/display task stacks
# (108 KiB combined) plus WiFi's runtime buffer pools were leaving too
# little contiguous internal DRAM by boot's end for the httpd task's
# 10 KiB stack, so `EspHttpServer::new()` failed every boot
# (`ESP_ERR_HTTPD_TASK`) — see wspr-app's own design memory for the
# `log_heap()` trail that root-caused this (171→99→86→62 KB before
# WiFi even starts). Officially supported on S3 for non-ISR task
# stacks (ESP-IDF's `external-ram.rst`); httpd's handlers are plain
# blocking calls, not ISR context, so this is the textbook case.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ── USB Host (UAC capture, Phase 1-Core) ────────────────────────────
# usb_host_install() consumes the USB-Serial-JTAG endpoint; BootMode::Uac
# therefore forces WiFi STA + UDP log so serial output doesn't vanish.
CONFIG_USB_HOST_ENABLED=y

# ── esp-dsp FFT — 8192 twiddle table ─────────────────────────────────
CONFIG_DSP_MAX_FFT_SIZE_8192=y

# ── USB host: external hub support ────────────────────────────────────
#
# The IC-705 does not present its USB audio directly. One cable to the
# radio enumerates **two USB devices on different hub ports** — Windows
# `usbipd list` shows `8-2  0c26:0036` (Icom, 2x CDC ACM for CI-V) and
# `8-4  08bb:2901` (a Texas Instruments PCM2901 audio codec) — so there
# is a hub inside the radio and the codec sits behind it.
#
# ESP-IDF's USB host defaults to no external-hub support, which is why
# the CoreS3 sat at "host + class driver up — waiting for IC-705
# enumeration" with the radio attached and never saw a `RxConnected`:
# not a cable, not VBUS, not a radio setting, and nothing the
# application could fix. Measured 2026-08-22, issue #163.
#
# The audio format behind that hub is exactly what `uac.rs` asks for —
# interface 2 alt 1, 2 ch / 16 bit / 48 000 Hz isochronous IN — so the
# hub is the only thing in the way.
#
# `USB_HOST_HUB_MULTI_LEVEL` defaults to `y` once hubs are on; the
# IC-705 needs only one level, but leaving the default costs nothing
# and covers a radio plugged in through a desk hub.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# `esp_log_level_set` can only raise a tag to a level the build kept.
# The USB enumeration path logs at DEBUG, and that is the path #163
# needs to see — a hub whose downstream ports are never walked looks
# exactly like an empty port from the class driver's side.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Enumeration buffer for the default (control) endpoint.
#
# The stock 256 bytes cannot hold a UAC device's configuration
# descriptor. The IC-705's audio interface enumerated as far as
# GET_FULL_DEV_DESC and then died on the next step:
#
#   E ENUM: Configuration descriptor larger than control transfer max length
#   E ENUM: [1:4] CHECK_SHORT_CONFIG_DESC FAILED
#     EXT_PORT: [1:4] Port disabled
#
# — leaving the hub and the CDC interface enumerated (num_devices=2)
# and the audio device gone, which from the class driver's side is
# simply an audio device that never appeared. Audio class descriptors
# are long: an audio control interface plus its streaming interfaces
# and format/endpoint descriptors runs past 256 bytes routinely.
#
# 1024 was still not enough — the same error came back. 4096 works, but
# only 1024 and 4096 were ever tested, and the buffer is per attached
# device out of internal DMA-capable RAM: at 4096 the IC-705's hub plus
# CDC plus audio take 12 KB out of the ~55 KB left after the host stack
# installs, which is what pushed lwIP and the WiFi driver into failing
# allocations. 2048 halves that and is still twice what failed.
#
# If enumeration regresses ("Configuration descriptor larger than
# control transfer max length" under ENUM), the descriptor is between
# 2048 and 4096 and this goes back up.
# Refs #163.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048

# Coredump to flash (#163).
#
# The panic handler's only output is the console, and in host mode the
# USB driver has taken it — so a crash leaves no message at all, which
# is exactly the state the stream-start reboot is in. The dump survives
# the reset; `main` reads its summary on the next boot and logs the
# exception cause, faulting PC and task over UDP/LCD.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64

# WiFi and lwIP allocate from PSRAM (#163).
#
# Judged by free internal DRAM at boot this looks like a regression —
# 68843 -> 36331 — and it was reverted on that basis, which was a
# mistake. The bytes go somewhere useful: with the option on, WiFi's TX
# buffers become a static pool claimed up front instead of dynamic
# allocations competing with everything else. Reserved is not the same
# as wasted.
#
# Judged by whether the board stays up, the verdict reverses cleanly.
# Boots observed inside a ~100 s capture, same hardware, same evening:
#
#   coredump enabled, no PSRAM option ............ 11
#   + SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y ............  1
#   control buffer 2048, PSRAM option still on ...  1
#   PSRAM option removed .........................  11
#   ... and 7-11 on every build after that
#
# Without it the network stack aborts on failed allocations —
# `esf_buf_alloc_dynamic` under `ieee80211_assoc_req_construct` in task
# `wifi`, `mem_malloc` under `pbuf_alloc` in task `tiT` — and since
# every reboot reconnects, the loop sustains itself.
#
# SPIRAM_MALLOC_ALWAYSINTERNAL stays at 4096; the dual-core decode path
# needs it there (see embedded-poc/CLAUDE.md).
#
# Not to be confused with CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC, which is
# genuinely harmful here — see the note above it.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# mbedTLS allocates from PSRAM (#163).
#
# The WPA2 four-way handshake computes its MIC through mbedTLS, and
# with internal DRAM down to ~38 KB during streaming that allocation
# fails and aborts — coredump, task `wifi`:
#
#   esp_mbedtls_mem_calloc <- mbedtls_calloc <- mbedtls_md_setup
#   <- hmac_vector <- hmac_sha1 <- wpa_eapol_key_mic
#   <- wpa_eapol_key_send
#
# Which made the reboot loop self-sustaining: every restart reconnects
# to WiFi, and every reconnect walks straight back into it.
#
# **CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y is NOT the fix — it is worse.**
# The S3's AES/SHA accelerators are DMA-driven and DMA cannot reach
# PSRAM, so moving mbedTLS's buffers there breaks hardware crypto
# outright: every AES operation fails to start its DMA and aborts.
#
#   aes_decrypt <- esp_aes_crypt_ecb <- esp_aes_process_dma
#   <- esp_crypto_shared_gdma_start_axi_ahb <- crypto_shared_gdma_init
#   <- gdma_new_ahb_channel
#
# WiFi uses AES constantly, so the board then crashed with no radio
# attached at all — seven reboots inside one flash capture, in
# peripheral mode. Tried and reverted 2026-08-23.

# Heap poisoning was here, and is deliberately gone (#163).
#
# It was added to find whoever was damaging the heap metadata that
# `tlsf_walk_pool` chokes on, and it "fixed" the symptom — which was
# the actual clue. Poisoning changes every allocation's size and
# therefore the whole layout; a bug that disappears under it is a bug
# that depends on where things landed. The writer was not a heap user
# at all: `display::run_log_panel` was overflowing the main task's
# stack into the internal heap pool immediately below it. See that
# function's snapshot buffers, and `CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK`
# above, which catches this class of failure at the store instead of
# at the next reader.
#
# Do not reintroduce it as a first move. Check `stack_hw` in the alive
# tick first — it costs nothing and it answered this in one flash.
