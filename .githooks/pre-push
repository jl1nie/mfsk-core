#!/usr/bin/env bash
# Local fence before a push: everything `.githooks/pre-commit` checks,
# plus `-D clippy::perf` and the feature matrix. The work lives in
# `scripts/pre-push-check.sh`, which is also how to run it by hand.
#
# Enabled by the same one-liner as the pre-commit hook — there is only
# one, and this file is why:
#
#   git config core.hooksPath .githooks
#
# This used to be installed into `.git/hooks/pre-push` by
# `scripts/install-hooks.sh`, which cannot work alongside the line
# above: `core.hooksPath` makes git read hooks from that directory
# *instead of* `$GIT_DIR/hooks`, never both. Following the setup
# instructions as written therefore left the feature matrix silently
# disabled — verified 2026-08-30 by putting an echo-only hook in
# `.git/hooks/pre-commit` and watching only the `.githooks` one fire.
# Nothing announces the shadowed hook; pushes just go through.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# git feeds one "<local ref> <local sha> <remote ref> <remote sha>" line
# per ref on stdin. A deletion has an all-zero local sha and builds
# nothing, so a bulk stale-branch cleanup (19 of them in one go, once)
# shouldn't pay for a 15-combo feature matrix.
have_update=0
have_ref=0
changed=""
unknown_base=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  have_ref=1
  case "$local_sha" in
    *[!0]*) have_update=1 ;;
    *) continue ;;
  esac
  # What this push adds: against the remote tip, or for a new branch
  # against where it forked from origin/main.
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ;;
    *) base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)" ;;
  esac
  if [ -n "$base" ] && git cat-file -e "$base^{commit}" 2>/dev/null; then
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  else
    unknown_base=1
  fi
done
if [ "$have_update" -eq 0 ]; then
  # Distinguish the two ways this happens, because "deletions only" on
  # an up-to-date push is a confusing thing to read while debugging a
  # failed commit.
  if [ "$have_ref" -eq 0 ]; then
    echo "==> pre-push: nothing to push, skipping checks"
  else
    echo "==> pre-push: deletions only, skipping checks"
  fi
  exit 0
fi

# Path filter. Anything this gate does not compile or test cannot be made
# worse by running it: docs, the embedded crates (own toolchain, never in
# this workspace), bindings, the Tauri GUI, wasm benches. An unknown base
# (e.g. the remote tip is not fetched) means the full gate.
#
#   nothing the gate covers        -> skip
#   only ffi / hosttest / skimmer  -> fmt + clippy + doc (+ ffi tests if ffi)
#   mfsk-core, Cargo.*, toolchain, the gate itself -> everything
if [ "$unknown_base" -eq 0 ]; then
  lib=0 ffi=0 rust=0
  while IFS= read -r f; do
    case "$f" in
      "") ;;
      mfsk-core/*|Cargo.toml|Cargo.lock|rust-toolchain.toml|.cargo/*|scripts/pre-push-check.sh|.githooks/*)
        lib=1; ffi=1; rust=1 ;;
      mfsk-ffi/*|mfsk-ffi-abi/*) ffi=1; rust=1 ;;
      hosttest/*|apps/skimmer/core/*|apps/skimmer/cli/*) rust=1 ;;
    esac
  done <<< "$changed"
  if [ "$rust" -eq 0 ]; then
    echo "==> pre-push: no Rust workspace paths in this push, skipping checks"
    exit 0
  fi
  export PREPUSH_MATRIX="$lib" PREPUSH_FFI="$ffi"
fi

exec scripts/pre-push-check.sh "$@"
